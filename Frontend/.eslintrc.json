{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "react",
    "unused-imports"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off",
    "no-unused-vars": "off",
    "unused-imports/no-unused-imports": "off",
    "unused-imports/no-unused-vars": "off",
    "react/no-unescaped-entities": "off",
    "no-empty": "off",
    "no-constant-condition": "off",
    "no-undef": "off",
    "react/display-name": "off",
    "react/no-unknown-property": "off",
    "no-empty-pattern": "off",
    "no-dupe-else-if": "off",
    "no-dupe-keys": "off",
    "no-unreachable": "off"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}